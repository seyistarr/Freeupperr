{
  "rewrites": [
    {
      "source": "/u/:freeupper_id",
      "destination": "/api/profile-preview?freeupper_id=:freeupper_id"
    },
    {
      "source": "/u/:freeupper_id/",
      "destination": "/api/profile-preview?freeupper_id=:freeupper_id"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/runtime-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "feature/global-push-notification-settings": false
    }
  }
}
