{
  "name": "freeupper",
  "version": "1.0.0",
  "type": "module",
  "description": "Freeupper – a video sharing platform",
  "main": "index.html",
  "scripts": {
    "start": "vercel dev",
    "deploy": "vercel --prod",
    "test:push": "node --test --test-isolation=none tests/push-client.test.mjs tests/push-notifications.test.mjs",
    "build": "node scripts/build-config.mjs",
    "test:staging": "node --test --test-isolation=none tests/staging-config.test.mjs tests/staging-schema.test.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/og": "^0.8.5",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "vercel": "^32.0.0"
  },
  "engines": {
    "node": ">=22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/freeupper.git"
  },
  "keywords": [
    "video",
    "social",
    "supabase"
  ],
