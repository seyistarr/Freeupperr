{
  "name": "freeupper",
  "version": "1.0.0",
  "type": "module",
  "description": "Freeupper – a video sharing platform",
  "main": "index.html",
  "scripts": {
    "start": "vercel dev",
    "deploy": "vercel --prod",
    "test:profile-seo": "node --test tests/profile-seo-privacy.test.js",
    "test:privacy-v2": "node --test tests/post-media-authorization.test.js tests/approved-asset-access.test.js tests/production-delivery-gate.test.js tests/production-media-resolver.test.js tests/post-media-disabled-handler.test.js tests/protected-media-client.test.js tests/protected-publishing-client.test.js tests/privacy-v2-pages.test.js tests/follow-approval-lifecycle.test.js tests/production-verification.test.js tests/verification-edge.test.js",
    "build:cloudflare": "node cloudflare/build.mjs",
    "deploy:cloudflare": "wrangler deploy --keep-vars",
    "test:cloudflare": "node --test tests/cloudflare.test.js tests/cloudflare-post-media.test.js",
    "test:api": "node --test tests/api-gateway.test.js",
    "deploy:api": "wrangler deploy --config cloudflare/api/wrangler.jsonc --keep-vars"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/og": "^0.8.5",
    "cloudinary": "^2.5.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "miniflare": "5.20261019.2-beta",
    "vercel": "^60.1.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/freeupper.git"
  },
  "keywords": [
    "video",
    "social",
    "supabase"
  ],
  "author": "Your Name",
  "license": "ISC"
}
