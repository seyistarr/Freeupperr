# PUBLIC configuration only. Replace placeholders; never add a service-role key or service-account JSON here.
# VERCEL_ENV is provided by Vercel. For a local build set VERCEL_ENV=development explicitly.
FREEUPPER_ENV=staging
APP_ORIGIN=https://YOUR-STABLE-STAGING-HOST
SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-STAGING-PUBLISHABLE-KEY
FIREBASE_API_KEY=YOUR-STAGING-WEB-API-KEY
FIREBASE_AUTH_DOMAIN=YOUR-STAGING-FIREBASE-ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR-STAGING-FIREBASE-ID
FIREBASE_STORAGE_BUCKET=YOUR-STAGING-FIREBASE-ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR-STAGING-SENDER-ID
FIREBASE_APP_ID=YOUR-STAGING-WEB-APP-ID
FIREBASE_VAPID_KEY=YOUR-STAGING-PUBLIC-VAPID-KEY
