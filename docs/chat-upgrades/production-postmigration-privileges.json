    "constraints": [
      {
        "name": "chat_activity_check",
        "definition": "CHECK (((expires_at > updated_at) AND (expires_at <= (updated_at + '00:00:07'::interval))))"
      },
      {
        "name": "chat_activity_check1",
        "definition": "CHECK ((((event = 'typing'::text) AND (kind IS NULL) AND (stage IS NULL)) OR ((event = 'activity'::text) AND ((active AND (kind IS NOT NULL)) OR (NOT active)))))"
      },
      {
        "name": "chat_activity_conversation_id_fkey",
        "definition": "FOREIGN KEY (conversation_id) REFERENCES conversations(id) ON DELETE CASCADE"
      },
      {
        "name": "chat_activity_conversation_id_user_id_source_id_event_key",
        "definition": "UNIQUE (conversation_id, user_id, source_id, event)"
      },
      {
        "name": "chat_activity_event_check",
        "definition": "CHECK ((event = ANY (ARRAY['typing'::text, 'activity'::text])))"
      },
      {
        "name": "chat_activity_kind_check",
        "definition": "CHECK ((kind = ANY (ARRAY['recording'::text, 'photo'::text, 'video'::text, 'media'::text])))"
      },
      {
        "name": "chat_activity_pkey",
        "definition": "PRIMARY KEY (id)"
      },
      {
        "name": "chat_activity_sequence_check",
        "definition": "CHECK (((sequence >= 1) AND (sequence <= '9007199254740991'::bigint)))"
      },
      {
        "name": "chat_activity_stage_check",
        "definition": "CHECK ((stage = ANY (ARRAY['preparing'::text, 'uploading'::text])))"
      },
      {
        "name": "chat_activity_user_id_fkey",
        "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
      }
