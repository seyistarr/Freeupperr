        {
          "cmd": "SELECT",
          "qual": "(EXISTS ( SELECT 1\n   FROM conversations c\n  WHERE ((c.id = messages.conversation_id) AND (((COALESCE(c.is_group, false) = false) AND (COALESCE(c.is_note, false) = false) AND ((c.user1_id = auth.uid()) OR (c.user2_id = auth.uid())) AND (NOT is_blocked_between(c.user1_id, c.user2_id))) OR (((COALESCE(c.is_group, false) = true) OR (COALESCE(c.is_note, false) = true)) AND ((c.user1_id = auth.uid()) OR (c.user2_id = auth.uid()) OR (EXISTS ( SELECT 1\n           FROM conversation_members cm\n          WHERE ((cm.conversation_id = c.id) AND (cm.user_id = auth.uid())))) OR ((c.is_note = true) AND (c.owner_id = auth.uid()))))))))",
          "roles": [
            "authenticated"
          ],
          "tablename": "messages",
          "permissive": "PERMISSIVE",
          "policyname": "members can view messages",
          "schemaname": "public",
