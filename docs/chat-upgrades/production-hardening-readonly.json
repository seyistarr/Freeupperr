          "policyname": "messages_insert_policy",
          "schemaname": "public",
          "with_check": "((auth.uid() = sender_id) AND ((EXISTS ( SELECT 1\n   FROM conversations c\n  WHERE ((c.id = messages.conversation_id) AND (COALESCE(c.is_group, false) = false) AND (COALESCE(c.is_note, false) = false) AND ((c.user1_id = auth.uid()) OR (c.user2_id = auth.uid())) AND (NOT is_blocked_between(c.user1_id, c.user2_id))))) OR (EXISTS ( SELECT 1\n   FROM conversations c\n  WHERE ((c.id = messages.conversation_id) AND (COALESCE(c.is_group, false) = true) AND (COALESCE(c.is_note, false) = false) AND (EXISTS ( SELECT 1\n           FROM conversation_members cm\n          WHERE ((cm.conversation_id = messages.conversation_id) AND (cm.user_id = auth.uid())))) AND can_send_in_conversation(messages.conversation_id)))) OR (EXISTS ( SELECT 1\n   FROM conversations c\n  WHERE ((c.id = messages.conversation_id) AND (c.is_note = true) AND (c.owner_id = auth.uid()))))))"
        }
      ]
    },
    {
      "section": "functions",
      "detail": [
        {
          "proacl": [
            "=X/supabase_realtime_admin",
            "supabase_realtime_admin=X/supabase_realtime_admin",
            "postgres=X/supabase_realtime_admin",
            "dashboard_user=X/supabase_realtime_admin"
          ],
          "nspname": "realtime",
          "proname": "topic",
          "proconfig": null,
          "prosecdef": false,
          "definition": "CREATE OR REPLACE FUNCTION realtime.topic()\n RETURNS text\n LANGUAGE sql\n STABLE\nAS $function$\nselect nullif(current_setting('realtime.topic', true), '')::text;\n$function$\n"
        },
        {
          "proacl": [
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "is_blocked_between",
          "proconfig": [
            "search_path=public"
          ],
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.is_blocked_between(p_user_a uuid, p_user_b uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n    SELECT EXISTS (\r\n        SELECT 1\r\n        FROM public.blocks b\r\n        WHERE\r\n            (b.blocker_id = p_user_a AND b.blocked_id = p_user_b)\r\n            OR\r\n            (b.blocker_id = p_user_b AND b.blocked_id = p_user_a)\r\n    );\r\n$function$\n"
        },
        {
          "proacl": [
            "=X/supabase_realtime_admin",
            "supabase_realtime_admin=X/supabase_realtime_admin",
            "postgres=X/supabase_realtime_admin",
            "dashboard_user=X/supabase_realtime_admin"
          ],
          "nspname": "realtime",
          "proname": "send",
          "proconfig": null,
          "prosecdef": false,
          "definition": "CREATE OR REPLACE FUNCTION realtime.send(payload jsonb, event text, topic text, private boolean DEFAULT true)\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n  generated_id uuid;\n  final_payload jsonb;\nBEGIN\n  BEGIN\n    generated_id := gen_random_uuid();\n\n    -- Check if payload has an 'id' key, if not, add the generated UUID\n    IF payload ? 'id' THEN\n      final_payload := payload;\n    ELSE\n      final_payload := jsonb_set(payload, '{id}', to_jsonb(generated_id));\n    END IF;\n\n    -- Set the topic configuration\n    EXECUTE format('SET LOCAL realtime.topic TO %L', topic);\n\n    INSERT INTO realtime.messages (id, payload, event, topic, private, extension)\n    VALUES (generated_id, final_payload, event, topic, private, 'broadcast');\n  EXCEPTION\n    WHEN OTHERS THEN\n      RAISE WARNING 'WarnSendingBroadcastMessage: %', SQLERRM;\n  END;\nEND;\n$function$\n"
        },
        {
          "proacl": [
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "claim_view_once",
          "proconfig": [
            "search_path=\"\""
          ],
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.claim_view_once(p_message_id uuid, p_media_index integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n    v_user uuid := auth.uid();\n    v_message public.messages%rowtype;\n    v_inserted integer;\n    v_expires_at timestamptz;\n    v_conv public.conversations%rowtype;\nbegin\n    if v_user is null then\n        raise exception 'Authentication required';\n    end if;\n\n    if p_message_id is null or p_media_index is null\n       or p_media_index < 0 then\n        raise exception 'Invalid view-once request';\n    end if;\n\n    select m.*\n      into v_message\n      from public.messages m\n     where m.id = p_message_id\n     for update;\n\n    if not found then\n        raise exception 'Message not found';\n    end if;\n\n    if v_message.sender_id = v_user then\n        raise exception 'Senders cannot open their own view-once media';\n    end if;\n\n    if v_message.message_type <> 'media'\n       or coalesce(v_message.metadata ->> 'view_once', 'false') <> 'true' then\n        raise exception 'This is not a view-once message';\n    end if;\n\n    if v_message.expires_at is not null\n       and v_message.expires_at <= now() then\n        raise exception 'This message has expired';\n    end if;\n\n    if jsonb_typeof(v_message.metadata -> 'media_items') is distinct from 'array'\n       or p_media_index >= jsonb_array_length(v_message.metadata -> 'media_items') then\n        raise exception 'Media item not found';\n    end if;\n\n    select c.*\n      into v_conv\n      from public.conversations c\n     where c.id = v_message.conversation_id;\n\n    if not found then\n        raise exception 'Conversation not found';\n    end if;\n\n    if coalesce(v_conv.is_group, false) = true\n       and coalesce(v_conv.is_note, false) = false then\n        if not exists (\n            select 1\n              from public.conversation_members cm\n             where cm.conversation_id = v_conv.id\n               and cm.user_id = v_user\n        ) then\n            raise exception 'You are not a member of this conversation';\n        end if;\n    elsif coalesce(v_conv.is_note, false) = true then\n        raise exception 'View-once media is not available in notes';\n    else\n        if v_conv.user1_id is distinct from v_user\n           and v_conv.user2_id is distinct from v_user then\n            raise exception 'You are not a participant in this conversation';\n        end if;\n\n        if public.is_blocked_between(v_conv.user1_id, v_conv.user2_id) then\n            raise exception 'This conversation is unavailable';\n        end if;\n    end if;\n\n    insert into public.view_once_consumptions (\n        message_id, viewer_id, media_index\n    )\n    values (\n        p_message_id, v_user, p_media_index\n    )\n    on conflict (message_id, viewer_id, media_index) do nothing;\n\n    get diagnostics v_inserted = row_count;\n\n    if v_inserted = 0 then\n        return jsonb_build_object('status', 'already_viewed');\n    end if;\n\n    select vc.expires_at\n      into v_expires_at\n      from public.view_once_consumptions vc\n     where vc.message_id = p_message_id\n       and vc.viewer_id = v_user\n       and vc.media_index = p_media_index;\n\n    return jsonb_build_object(\n        'status', 'opened',\n        'expires_at', v_expires_at\n    );\nend;\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "can_send_in_conversation",
          "proconfig": [
            "search_path=public"
          ],
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.can_send_in_conversation(p_conversation_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT\r\n    CASE\r\n      WHEN NOT c.is_group THEN true\r\n      WHEN c.is_note THEN true\r\n      WHEN COALESCE(c.permissions->>'send_messages', 'everyone') = 'everyone' THEN true\r\n      ELSE EXISTS (\r\n        SELECT 1 FROM conversation_members cm\r\n        WHERE cm.conversation_id = p_conversation_id\r\n          AND cm.user_id = auth.uid()\r\n          AND cm.role IN ('owner', 'admin')\r\n      )\r\n    END\r\n  FROM conversations c\r\n  WHERE c.id = p_conversation_id;\r\n$function$\n"
        }
      ]
    },
