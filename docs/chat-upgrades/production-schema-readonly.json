    {
      "section": "functions",
      "detail": [
        {
          "proacl": [
            "=X/supabase_realtime_admin",
            "supabase_realtime_admin=X/supabase_realtime_admin",
            "postgres=X/supabase_realtime_admin",
            "dashboard_user=X/supabase_realtime_admin"
          ],
          "nspname": "realtime",
          "proname": "topic",
          "prosecdef": false,
          "definition": "CREATE OR REPLACE FUNCTION realtime.topic()\n RETURNS text\n LANGUAGE sql\n STABLE\nAS $function$\nselect nullif(current_setting('realtime.topic', true), '')::text;\n$function$\n"
        },
        {
          "proacl": [
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "is_blocked_between",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.is_blocked_between(p_user_a uuid, p_user_b uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n    SELECT EXISTS (\r\n        SELECT 1\r\n        FROM public.blocks b\r\n        WHERE\r\n            (b.blocker_id = p_user_a AND b.blocked_id = p_user_b)\r\n            OR\r\n            (b.blocker_id = p_user_b AND b.blocked_id = p_user_a)\r\n    );\r\n$function$\n"
        },
        {
          "proacl": [
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "conversation_created_by",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.conversation_created_by(p_conversation_id uuid, p_user_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n    SELECT EXISTS (\r\n        SELECT 1\r\n        FROM public.conversations c\r\n        WHERE c.id = p_conversation_id\r\n          AND c.created_by = p_user_id\r\n    );\r\n$function$\n"
        },
        {
          "proacl": [
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "unblock_user",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.unblock_user(p_blocked_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nBEGIN\r\n\r\n    IF auth.uid() IS NULL THEN\r\n        RAISE EXCEPTION 'Authentication required';\r\n    END IF;\r\n\r\n    DELETE FROM public.blocks\r\n    WHERE\r\n        blocker_id = auth.uid()\r\n        AND blocked_id = p_blocked_id;\r\n\r\nEND;\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "update_conversation_updated_at",
          "prosecdef": false,
          "definition": "CREATE OR REPLACE FUNCTION public.update_conversation_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n    NEW.updated_at = NOW();\r\n    RETURN NEW;\r\nEND;\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "is_conversation_member",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.is_conversation_member(conv_id uuid, uid uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  select exists (\r\n    select 1 from conversation_members\r\n    where conversation_id = conv_id and user_id = uid\r\n  );\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "update_conversation_last_message",
          "prosecdef": false,
          "definition": "CREATE OR REPLACE FUNCTION public.update_conversation_last_message()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n    UPDATE conversations\r\n    SET last_message_id = NEW.id,\r\n        last_message_at = NEW.created_at,\r\n        last_sender_id = NEW.sender_id,\r\n        updated_at = NEW.created_at\r\n    WHERE id = NEW.conversation_id;\r\n    RETURN NEW;\r\nEND;\r\n$function$\n"
        },
        {
          "proacl": [
            "=X/postgres",
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "set_member_role",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.set_member_role(p_conversation_id uuid, p_target_user_id uuid, p_new_role text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\ndeclare\r\n  v_caller_role text;\r\n  v_target_role text;\r\nbegin\r\n  select role into v_caller_role from public.conversation_members\r\n  where conversation_id = p_conversation_id and user_id = auth.uid();\r\n\r\n  select role into v_target_role from public.conversation_members\r\n  where conversation_id = p_conversation_id and user_id = p_target_user_id;\r\n\r\n  if v_caller_role != 'owner' then\r\n    raise exception 'Only the group owner can assign or remove admins';\r\n  end if;\r\n\r\n  if v_target_role = 'owner' then\r\n    raise exception 'Cannot change the owner''s role';\r\n  end if;\r\n\r\n  if p_new_role not in ('admin', 'member') then\r\n    raise exception 'Invalid role';\r\n  end if;\r\n\r\n  update public.conversation_members\r\n  set role = p_new_role\r\n  where conversation_id = p_conversation_id and user_id = p_target_user_id;\r\nend;\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "is_member_of_conversation",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.is_member_of_conversation(p_conversation_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT EXISTS (\r\n    SELECT 1 FROM conversation_members\r\n    WHERE conversation_id = p_conversation_id\r\n      AND user_id = auth.uid()\r\n  );\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "can_send_in_conversation",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.can_send_in_conversation(p_conversation_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT\r\n    CASE\r\n      WHEN NOT c.is_group THEN true\r\n      WHEN c.is_note THEN true\r\n      WHEN COALESCE(c.permissions->>'send_messages', 'everyone') = 'everyone' THEN true\r\n      ELSE EXISTS (\r\n        SELECT 1 FROM conversation_members cm\r\n        WHERE cm.conversation_id = p_conversation_id\r\n          AND cm.user_id = auth.uid()\r\n          AND cm.role IN ('owner', 'admin')\r\n      )\r\n    END\r\n  FROM conversations c\r\n  WHERE c.id = p_conversation_id;\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "is_owner_or_admin_of_conversation",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.is_owner_or_admin_of_conversation(p_conversation_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT EXISTS (\r\n    SELECT 1 FROM conversation_members\r\n    WHERE conversation_id = p_conversation_id\r\n      AND user_id = auth.uid()\r\n      AND role IN ('owner','admin')\r\n  );\r\n$function$\n"
        },
        {
          "proacl": null,
          "nspname": "public",
          "proname": "conversation_has_any_members",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.conversation_has_any_members(p_conversation_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT EXISTS (\r\n    SELECT 1\r\n    FROM public.conversation_members\r\n    WHERE conversation_id = p_conversation_id\r\n  );\r\n$function$\n"
        },
        {
          "proacl": [
            "postgres=X/postgres",
            "authenticated=X/postgres"
          ],
          "nspname": "public",
          "proname": "block_user",
          "prosecdef": true,
          "definition": "CREATE OR REPLACE FUNCTION public.block_user(p_blocked_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nDECLARE\r\n    v_blocker_id uuid := auth.uid();\r\nBEGIN\r\n\r\n    IF v_blocker_id IS NULL THEN\r\n        RAISE EXCEPTION 'Authentication required';\r\n    END IF;\r\n\r\n    IF p_blocked_id IS NULL THEN\r\n        RAISE EXCEPTION 'Blocked user is required';\r\n    END IF;\r\n\r\n    IF p_blocked_id = v_blocker_id THEN\r\n        RAISE EXCEPTION 'You cannot block yourself';\r\n    END IF;\r\n\r\n    INSERT INTO public.blocks (blocker_id, blocked_id)\r\n    VALUES (v_blocker_id, p_blocked_id)\r\n    ON CONFLICT DO NOTHING;\r\n\r\n    DELETE FROM public.follows\r\n    WHERE\r\n        (follower_id = v_blocker_id AND following_id = p_blocked_id)\r\n        OR\r\n        (follower_id = p_blocked_id AND following_id = v_blocker_id);\r\n\r\n    DELETE FROM public.dismissed_suggestions\r\n    WHERE\r\n        user_id = v_blocker_id\r\n        AND dismissed_user_id = p_blocked_id;\r\n\r\nEND;\r\n$function$\n"
        }
      ]
    },
