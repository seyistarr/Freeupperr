    {
      "section": "policies",
      "detail": [
        {
          "cmd": "SELECT",
          "qual": "is_member_of_conversation(conversation_id)",
          "roles": [
            "public"
          ],
          "tablename": "conversation_members",
          "permissive": "PERMISSIVE",
          "policyname": "Users can view members of their conversations",
          "schemaname": "public",
          "with_check": null
        },
        {
          "cmd": "DELETE",
          "qual": "((EXISTS ( SELECT 1\n   FROM conversation_members admin_check\n  WHERE ((admin_check.conversation_id = conversation_members.conversation_id) AND (admin_check.user_id = auth.uid()) AND (admin_check.role = 'admin'::text)))) OR (user_id = auth.uid()))",
          "roles": [
            "authenticated"
          ],
          "tablename": "conversation_members",
          "permissive": "PERMISSIVE",
          "policyname": "admins can remove group members",
          "schemaname": "public",
          "with_check": null
        },
        {
          "cmd": "INSERT",
          "qual": null,
          "roles": [
            "authenticated"
          ],
          "tablename": "conversation_members",
          "permissive": "PERMISSIVE",
          "policyname": "conversation_members_insert_policy",
          "schemaname": "public",
          "with_check": "(((user_id = auth.uid()) AND (role = 'owner'::text) AND conversation_created_by(conversation_id, auth.uid()) AND (NOT conversation_has_any_members(conversation_id))) OR ((role = 'member'::text) AND conversation_created_by(conversation_id, auth.uid()) AND (NOT conversation_has_any_members(conversation_id))) OR ((role = ANY (ARRAY['member'::text, 'admin'::text])) AND is_owner_or_admin_of_conversation(conversation_id)))"
        },
        {
          "cmd": "SELECT",
          "qual": "(user_id = auth.uid())",
          "roles": [
            "authenticated"
          ],
          "tablename": "conversation_members",
          "permissive": "PERMISSIVE",
          "policyname": "members can view own memberships",
          "schemaname": "public",
          "with_check": null
        },
        {
          "cmd": "ALL",
          "qual": "(auth.uid() = blocker_id)",
          "roles": [
            "authenticated"
          ],
          "tablename": "blocks",
          "permissive": "PERMISSIVE",
          "policyname": "blocks_owner_manage",
          "schemaname": "public",
          "with_check": "(auth.uid() = blocker_id)"
        },
        {
          "cmd": "UPDATE",
          "qual": "((auth.uid() = user1_id) OR (auth.uid() = user2_id))",
          "roles": [
            "public"
          ],
          "tablename": "conversations",
          "permissive": "PERMISSIVE",
          "policyname": "Users can update their own conversations",
          "schemaname": "public",
          "with_check": null
        },
        {
          "cmd": "UPDATE",
          "qual": "((auth.uid() = user1_id) OR (auth.uid() = user2_id) OR (EXISTS ( SELECT 1\n   FROM conversation_members cm\n  WHERE ((cm.conversation_id = conversations.id) AND (cm.user_id = auth.uid())))))",
          "roles": [
            "public"
          ],
          "tablename": "conversations",
          "permissive": "PERMISSIVE",
          "policyname": "conversation participants can update",
          "schemaname": "public",
          "with_check": "((auth.uid() = user1_id) OR (auth.uid() = user2_id) OR (EXISTS ( SELECT 1\n   FROM conversation_members cm\n  WHERE ((cm.conversation_id = conversations.id) AND (cm.user_id = auth.uid()) AND true))))"
        },
        {
          "cmd": "INSERT",
          "qual": null,
          "roles": [
            "authenticated"
          ],
          "tablename": "conversations",
