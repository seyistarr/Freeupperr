  "views": [
    {
      "kind": "v",
      "name": "repost_feed_items",
      "options": [
        "security_invoker=true"
      ],
      "definition": " SELECT r.id AS repost_id,\n    r.post_id,\n    r.user_id AS reposter_id,\n    r.comment AS repost_comment,\n    r.created_at AS repost_created_at,\n    reposter.display_name AS reposter_display_name,\n    reposter.username AS reposter_username,\n    reposter.avatar_url AS reposter_avatar_url,\n    reposter.verified_status AS reposter_verified_status\n   FROM reposts r\n     JOIN profiles reposter ON reposter.id = r.user_id;"
    }
  ],
