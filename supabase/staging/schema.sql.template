CREATE OR REPLACE FUNCTION public.delete_post(p_post_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_catalog'
AS $function$
begin
  if auth.uid() is null then
    raise exception 'Authentication required';
  end if;

  if not exists (
    select 1
    from public.posts
    where id = p_post_id
      and user_id = auth.uid()
  ) then
    raise exception 'You can only delete your own post';
  end if;

  delete from public.post_likes where post_id = p_post_id;
  delete from public.comment_likes
    where comment_id in (
      select id from public.comments where post_id = p_post_id
    );
  delete from public.comments where post_id = p_post_id;
  delete from public.reposts where post_id = p_post_id;
  delete from public.bookmarks where post_id = p_post_id;
  delete from public.shares where post_id = p_post_id;
  delete from public.post_views where post_id = p_post_id;
  delete from public.posts
    where id = p_post_id
      and user_id = auth.uid();
end;
$function$;

CREATE OR REPLACE FUNCTION public.restore_post(p_post_id uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM posts WHERE id = p_post_id AND user_id = auth.uid() AND is_deleted = true) THEN
    RAISE EXCEPTION 'Post not found or not deleted';
  END IF;
  UPDATE posts SET is_deleted = false, deleted_at = NULL WHERE id = p_post_id;
  RETURN true;
END;
$function$;

CREATE OR REPLACE FUNCTION public.create_original_sound_for_post(p_post_id uuid, p_audio_url text, p_art_url text DEFAULT NULL::text, p_title text DEFAULT NULL::text)
 RETURNS sounds
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_user_id uuid := auth.uid();
  v_post public.posts%rowtype;
  v_sound public.sounds%rowtype;
  v_profile public.profiles%rowtype;
  v_title text;
begin
  if v_user_id is null then
    raise exception 'Authentication required';
  end if;

  if p_post_id is null or nullif(trim(p_audio_url), '') is null then
    raise exception 'Post ID and audio URL are required';
  end if;

  select *
  into v_post
  from public.posts
  where id = p_post_id
    and user_id = v_user_id
    and media_type = 'video';

  if not found then
    raise exception 'Video post not found or not owned by current user';
  end if;

  if v_post.sound_id is not null then
    select * into v_sound from public.sounds where id = v_post.sound_id;
    if found then return v_sound; end if;
  end if;

  select *
  into v_sound
  from public.sounds
  where source_post_id = p_post_id
  limit 1;

  if found then
    update public.posts
    set sound_id = v_sound.id
    where id = p_post_id and user_id = v_user_id;
    return v_sound;
  end if;

  select * into v_profile
  from public.profiles
  where id = v_user_id;

  v_title := coalesce(
    nullif(trim(p_title), ''),
    'Original sound · ' ||
    coalesce(
      nullif(v_profile.display_name, ''),
      nullif(v_profile.username, ''),
      'FreeUpper user'
    )
  );

  insert into public.sounds (
    title,
    artist_name,
    audio_url,
    art_url,
    created_by,
    source_post_id,
    sound_type,
    is_original,
    status,
    usage_count
  )
  values (
    v_title,
    coalesce(
      nullif(v_profile.display_name, ''),
      nullif(v_profile.username, ''),
      'FreeUpper user'
    ),
    p_audio_url,
    p_art_url,
    v_user_id,
    p_post_id,
    'original',
    true,
    'active',
    1
  )
  returning * into v_sound;

  update public.posts
  set sound_id = v_sound.id
  where id = p_post_id and user_id = v_user_id;

  return v_sound;
end;
$function$;

