  SELECT
    p.id,
    p.freeupper_id,
    p.username,
    p.display_name,
    p.display_username,
    p.avatar_url,
    p.cover_url,
    p.bio,
    p.verified,
    p.verified_status,
    p.verification_status,
    p.is_private,
    p.hide_follower_count,
    p.activity_status,
    p.country,
    p.created_at
  FROM public.profiles AS p
