CREATE OR REPLACE FUNCTION public.cast_chat_poll_vote(p_message_id uuid, p_option_index integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
declare
    v_user_id uuid := auth.uid();
    v_message public.messages%rowtype;
    v_poll jsonb;
    v_options jsonb;
    v_option jsonb;
    v_new_options jsonb := '[]'::jsonb;
    v_old_option integer;
    v_had_vote boolean := false;
    v_index integer := 0;
    v_votes integer;
    v_delta integer;
begin
    if v_user_id is null then
        raise exception 'Authentication required';
    end if;

    if p_message_id is null
       or (p_option_index is not null and p_option_index < 0) then
        raise exception 'Invalid poll vote';
    end if;

    select m.*
      into v_message
      from public.messages m
     where m.id = p_message_id
     for update;

    if not found then
        raise exception 'Poll not found';
    end if;

    if v_message.message_type is distinct from 'poll'
       or v_message.poll_data is null then
        raise exception 'Message is not a poll';
    end if;

    if v_message.expires_at is not null
       and v_message.expires_at <= now() then
        raise exception 'This poll has expired';
    end if;

    if not exists (
        select 1
          from public.conversations c
         where c.id = v_message.conversation_id
           and (
               (
                   coalesce(c.is_group, false) = false
                   and coalesce(c.is_note, false) = false
                   and (c.user1_id = v_user_id or c.user2_id = v_user_id)
                   and not public.is_blocked_between(c.user1_id, c.user2_id)
               )
               or (
                   coalesce(c.is_group, false) = true
                   and coalesce(c.is_note, false) = false
                   and exists (
                       select 1
                         from public.conversation_members cm
                        where cm.conversation_id = c.id
                          and cm.user_id = v_user_id
                   )
               )
               or (
                   coalesce(c.is_note, false) = true
                   and c.owner_id = v_user_id
               )
           )
    ) then
        raise exception 'You cannot vote in this conversation';
    end if;

    v_poll := v_message.poll_data - 'userVote';

    if coalesce(v_poll ->> 'expiresAt', '') <> '' then
        if (v_poll ->> 'expiresAt')::timestamptz <= now() then
            raise exception 'This poll has expired';
        end if;
    end if;

    v_options := v_poll -> 'options';

    if jsonb_typeof(v_options) is distinct from 'array' then
        raise exception 'Invalid poll options';
    end if;

    if jsonb_array_length(v_options) = 0 then
        raise exception 'Poll has no options';
    end if;

    if p_option_index is not null
       and p_option_index >= jsonb_array_length(v_options) then
        raise exception 'Invalid poll option';
    end if;

    select pv.option_index
      into v_old_option
      from public.chat_poll_votes pv
     where pv.message_id = p_message_id
       and pv.user_id = v_user_id;

    v_had_vote := found;

    if p_option_index is not null
       and v_had_vote
       and v_old_option = p_option_index then
        return jsonb_build_object(
            'poll_data', v_poll,
            'user_vote', v_old_option
        );
    end if;

    if p_option_index is null then
        if v_had_vote then
            delete from public.chat_poll_votes
             where message_id = p_message_id
               and user_id = v_user_id;
        end if;
    else
        insert into public.chat_poll_votes (
            message_id, user_id, option_index
        )
        values (
            p_message_id, v_user_id, p_option_index
        )
        on conflict (message_id, user_id)
        do update set
            option_index = excluded.option_index,
            updated_at = now();
    end if;

    for v_option in
        select e.value
          from jsonb_array_elements(v_options)
               with ordinality as e(value, ord)
         order by e.ord
    loop
        v_votes := case
            when coalesce(v_option ->> 'votes', '') ~ '^[0-9]+$'
            then (v_option ->> 'votes')::integer
            else 0
        end;

        v_delta := 0;

        if v_had_vote and v_index = v_old_option then
            v_delta := v_delta - 1;
        end if;

        if p_option_index is not null
           and v_index = p_option_index then
            v_delta := v_delta + 1;
        end if;

        v_option := jsonb_set(
            v_option,
            '{votes}',
            to_jsonb(greatest(0, v_votes + v_delta)),
            true
        );

        v_new_options := v_new_options || jsonb_build_array(v_option);
        v_index := v_index + 1;
    end loop;

    v_poll := jsonb_set(v_poll, '{options}', v_new_options, true);
    v_poll := jsonb_set(
        v_poll,
        '{totalVotes}',
        to_jsonb(
            greatest(
                0,
                coalesce((
                    select sum(
                        case
                            when coalesce(e.value ->> 'votes', '') ~ '^[0-9]+$'
                            then (e.value ->> 'votes')::integer
                            else 0
                        end
                    )
                    from jsonb_array_elements(v_new_options) as e(value)
                ), 0)
            )
        ),
        true
    );

    update public.messages
       set poll_data = v_poll
     where id = p_message_id;

    return jsonb_build_object(
        'poll_data', v_poll,
        'user_vote', p_option_index
    );
end;
$function$;

CREATE OR REPLACE FUNCTION public.apply_verification_approval()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
begin
  if new.status = 'approved' and old.status is distinct from 'approved' then
    update public.profiles set verified = true where id = new.user_id;
  elsif new.status = 'rejected' and old.status is distinct from 'rejected' then
    update public.profiles set verified = false where id = new.user_id;
  end if;
  return new;
end;
$function$;

CREATE OR REPLACE FUNCTION public.claim_view_once(p_message_id uuid, p_media_index integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
declare
    v_user uuid := auth.uid();
    v_message public.messages%rowtype;
    v_inserted integer;
    v_expires_at timestamptz;
    v_conv public.conversations%rowtype;
begin
    if v_user is null then
        raise exception 'Authentication required';
    end if;

    if p_message_id is null or p_media_index is null
       or p_media_index < 0 then
        raise exception 'Invalid view-once request';
    end if;

    select m.*
      into v_message
      from public.messages m
     where m.id = p_message_id
     for update;

    if not found then
        raise exception 'Message not found';
    end if;

    if v_message.sender_id = v_user then
        raise exception 'Senders cannot open their own view-once media';
    end if;

    if v_message.message_type <> 'media'
       or coalesce(v_message.metadata ->> 'view_once', 'false') <> 'true' then
        raise exception 'This is not a view-once message';
    end if;

    if v_message.expires_at is not null
       and v_message.expires_at <= now() then
        raise exception 'This message has expired';
    end if;

    if jsonb_typeof(v_message.metadata -> 'media_items') is distinct from 'array'
       or p_media_index >= jsonb_array_length(v_message.metadata -> 'media_items') then
        raise exception 'Media item not found';
    end if;

    select c.*
      into v_conv
      from public.conversations c
     where c.id = v_message.conversation_id;

    if not found then
        raise exception 'Conversation not found';
    end if;

    if coalesce(v_conv.is_group, false) = true
       and coalesce(v_conv.is_note, false) = false then
        if not exists (
            select 1
              from public.conversation_members cm
             where cm.conversation_id = v_conv.id
               and cm.user_id = v_user
        ) then
            raise exception 'You are not a member of this conversation';
        end if;
    elsif coalesce(v_conv.is_note, false) = true then
        raise exception 'View-once media is not available in notes';
    else
        if v_conv.user1_id is distinct from v_user
           and v_conv.user2_id is distinct from v_user then
            raise exception 'You are not a participant in this conversation';
        end if;

        if public.is_blocked_between(v_conv.user1_id, v_conv.user2_id) then
            raise exception 'This conversation is unavailable';
        end if;
    end if;

    insert into public.view_once_consumptions (
        message_id, viewer_id, media_index
    )
    values (
        p_message_id, v_user, p_media_index
    )
    on conflict (message_id, viewer_id, media_index) do nothing;

    get diagnostics v_inserted = row_count;

    if v_inserted = 0 then
        return jsonb_build_object('status', 'already_viewed');
    end if;

    select vc.expires_at
      into v_expires_at
      from public.view_once_consumptions vc
     where vc.message_id = p_message_id
       and vc.viewer_id = v_user
       and vc.media_index = p_media_index;

    return jsonb_build_object(
        'status', 'opened',
        'expires_at', v_expires_at
    );
end;
$function$;

CREATE OR REPLACE FUNCTION public.increment_post_views()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
  UPDATE posts SET views = COALESCE(views, 0) + 1 WHERE id = NEW.post_id;
  RETURN NULL;
END;
$function$;

CREATE OR REPLACE FUNCTION public.parse_mentions(p_post_id uuid, p_content text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  mention_pattern TEXT := '@([a-zA-Z0-9_]+)';
  mention_username TEXT;
  user_id UUID;
BEGIN
  DELETE FROM mentions WHERE post_id = p_post_id;
  FOR mention_username IN (SELECT regexp_matches(p_content, mention_pattern, 'g') AS m)
  LOOP
    SELECT id INTO user_id FROM profiles WHERE profiles.username = mention_username;
    IF user_id IS NOT NULL THEN
      INSERT INTO mentions (post_id, mentioned_user_id) VALUES (p_post_id, user_id);
    END IF;
  END LOOP;
END;
$function$;

CREATE OR REPLACE FUNCTION public.notify_repost()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_post_owner UUID;
BEGIN
  SELECT user_id INTO v_post_owner
  FROM posts
  WHERE id = NEW.post_id;

  IF v_post_owner IS NULL THEN
    RETURN NEW;
  END IF;

  IF v_post_owner = NEW.user_id THEN
    RETURN NEW;
  END IF;

  PERFORM create_notification(
    v_post_owner,
    NEW.user_id,
    'repost',
    NEW.post_id,
    NULL
  );

  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.edit_post(p_post_id uuid, p_content text, p_title text DEFAULT NULL::text, p_description text DEFAULT NULL::text, p_category text DEFAULT NULL::text, p_tags text[] DEFAULT NULL::text[], p_visibility text DEFAULT 'public'::text)
 RETURNS posts
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  updated_post posts;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM posts WHERE id = p_post_id AND user_id = auth.uid() AND is_deleted = false) THEN
    RAISE EXCEPTION 'Post not found or not owned';
  END IF;
  IF p_content IS NULL OR trim(p_content) = '' THEN
    RAISE EXCEPTION 'Content cannot be empty';
  END IF;
  UPDATE posts
  SET
    content = p_content,
    title = COALESCE(p_title, title),
    description = COALESCE(p_description, description),
    category = COALESCE(p_category, category),
    tags = COALESCE(p_tags, tags),
    visibility = COALESCE(p_visibility, visibility),
    edited_at = now(),
    version = version + 1
  WHERE id = p_post_id
  RETURNING * INTO updated_post;
  PERFORM parse_mentions(p_post_id, p_content);
  RETURN updated_post;
END;
$function$;

CREATE OR REPLACE FUNCTION public.toggle_follow_with_notification(p_target_id uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_user_id UUID := auth.uid();
  exists_follow BOOLEAN;
BEGIN
  IF v_user_id IS NULL THEN
    RAISE EXCEPTION 'Not authenticated';
  END IF;
  IF p_target_id = v_user_id THEN
    RAISE EXCEPTION 'Cannot follow yourself';
  END IF;
  SELECT EXISTS(SELECT 1 FROM follows WHERE follower_id = v_user_id AND following_id = p_target_id)
  INTO exists_follow;
  IF exists_follow THEN
    DELETE FROM follows WHERE follower_id = v_user_id AND following_id = p_target_id;
  ELSE
    INSERT INTO follows (follower_id, following_id) VALUES (v_user_id, p_target_id);
    PERFORM create_notification(p_target_id, v_user_id, 'follow');
  END IF;
  RETURN NOT exists_follow;
END;
$function$;

CREATE OR REPLACE FUNCTION public.report_content(p_target_type text, p_target_id uuid, p_reason text)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
  IF p_target_type NOT IN ('post','comment','profile') THEN
    RAISE EXCEPTION 'Invalid target type';
  END IF;
  INSERT INTO reports (reporter_id, target_type, target_id, reason)
  VALUES (auth.uid(), p_target_type, p_target_id, p_reason);
  RETURN true;
END;
$function$;

CREATE OR REPLACE FUNCTION public.search_posts(query text, limit_count integer DEFAULT 20)
 RETURNS TABLE(id uuid, title text, content text, created_at timestamp with time zone, display_name text, username text, avatar_url text, verified_status text, relevance real)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
  RETURN QUERY
  SELECT
    p.id,
    p.title,
    p.content,
    p.created_at,
    pr.display_name,
    pr.username,
    pr.avatar_url,
    pr.verified_status,
    ts_rank_cd(to_tsvector('english', p.title || ' ' || p.content), plainto_tsquery('english', query)) AS relevance
  FROM posts p
  LEFT JOIN profiles pr ON p.user_id = pr.id
  WHERE p.is_deleted = false
    AND p.visibility = 'public'
    AND to_tsvector('english', p.title || ' ' || p.content) @@ plainto_tsquery('english', query)
  ORDER BY relevance DESC
  LIMIT limit_count;
END;
$function$;

CREATE OR REPLACE FUNCTION public.get_notifications(limit_count integer DEFAULT 20, offset_count integer DEFAULT 0)
 RETURNS TABLE(id bigint, type text, actor_id uuid, actor_name text, actor_avatar text, post_id uuid, comment_id uuid, read boolean, created_at timestamp with time zone)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
  RETURN QUERY
  SELECT
    n.id,
    n.type,
    n.actor_id,
    pr.display_name AS actor_name,
    pr.avatar_url AS actor_avatar,
    n.post_id,
    n.comment_id,
    n.read,
    n.created_at
  FROM notifications n
  LEFT JOIN profiles pr ON n.actor_id = pr.id
  WHERE n.receiver_id = auth.uid()
  ORDER BY n.created_at DESC
  LIMIT limit_count
  OFFSET offset_count;
END;
$function$;

CREATE OR REPLACE FUNCTION public.mark_notification_read(p_notification_id bigint)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
