CREATE OR REPLACE FUNCTION public.record_share(p_post_id uuid, p_user_id uuid)
 RETURNS TABLE(already_shared boolean, count integer)
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_exists boolean;
  v_count int;
begin
  select exists(
    select 1 from shares where post_id = p_post_id and user_id = p_user_id
  ) into v_exists;

  if v_exists then
    select share_count into v_count from posts where id = p_post_id;
    return query select true, v_count;
  else
    insert into shares (post_id, user_id, created_at) values (p_post_id, p_user_id, now());
    update posts set share_count = share_count + 1 where id = p_post_id
      returning share_count into v_count;
    return query select false, v_count;
  end if;
end;
$function$;

CREATE OR REPLACE FUNCTION public.delete_comment(p_comment_id uuid, p_user_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_post_id uuid;
  v_parent_id uuid;
  v_owner_id uuid;
  v_post_owner_id uuid;
begin
  select post_id, parent_id, user_id
    into v_post_id, v_parent_id, v_owner_id
    from comments
    where id = p_comment_id;

  if v_owner_id is null then
    raise exception 'Comment not found.';
  end if;

  select user_id into v_post_owner_id from posts where id = v_post_id;

  -- Only the comment's author OR the post's owner may delete it.
  if v_owner_id != p_user_id and v_post_owner_id != p_user_id then
    raise exception 'You do not have permission to delete this comment.';
  end if;

  -- Clean up replies-of-this-comment first (and their likes)
  delete from comment_likes where comment_id in (
    select id from comments where parent_id = p_comment_id
  );
  delete from comments where parent_id = p_comment_id;

  -- Clean up this comment's own likes, then the comment itself
  delete from comment_likes where comment_id = p_comment_id;
  delete from comments where id = p_comment_id;

  perform decrement_comment_count(v_post_id, v_parent_id);
end;
$function$;

CREATE OR REPLACE FUNCTION public.edit_comment(p_comment_id uuid, p_user_id uuid, p_message text)
 RETURNS TABLE(id uuid, message text, updated_at timestamp with time zone, edited boolean)
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_owner_id uuid;
begin
  select user_id into v_owner_id from comments where id = p_comment_id;

  if v_owner_id is null then
    raise exception 'Comment not found.';
  end if;

  if v_owner_id != p_user_id then
    raise exception 'You do not have permission to edit this comment.';
  end if;

  if trim(coalesce(p_message, '')) = '' then
    raise exception 'Comment cannot be empty.';
  end if;

  return query
    update comments
    set message = trim(p_message),
        updated_at = now(),
        edited = true
    where comments.id = p_comment_id
    returning comments.id, comments.message, comments.updated_at, comments.edited;
end;
$function$;

CREATE OR REPLACE FUNCTION public.toggle_pin_comment(p_comment_id uuid, p_user_id uuid)
 RETURNS TABLE(pinned boolean)
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_post_id uuid;
  v_post_owner_id uuid;
  v_currently_pinned boolean;
begin
  select post_id, pinned into v_post_id, v_currently_pinned
    from comments where id = p_comment_id;

  if v_post_id is null then
    raise exception 'Comment not found.';
  end if;

  select user_id into v_post_owner_id from posts where id = v_post_id;

  if v_post_owner_id != p_user_id then
    raise exception 'Only the post owner can pin comments.';
  end if;

  if v_currently_pinned then
    -- Unpin
    update comments set pinned = false where id = p_comment_id;
    return query select false;
  else
    -- Unpin any existing pinned comment on this post, then pin this one
    update comments set pinned = false where post_id = v_post_id and pinned = true;
    update comments set pinned = true where id = p_comment_id;
    return query select true;
  end if;
end;
$function$;

CREATE OR REPLACE FUNCTION public.increment_comment_count(p_post_id uuid, p_parent_id uuid DEFAULT NULL::uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
begin
  update posts set comment_count = comment_count + 1 where id = p_post_id;

  if p_parent_id is not null then
    update comments set reply_count = reply_count + 1 where id = p_parent_id;
  end if;
end;
$function$;

CREATE OR REPLACE FUNCTION public.decrement_comment_count(p_post_id uuid, p_parent_id uuid DEFAULT NULL::uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
begin
  update posts set comment_count = greatest(0, comment_count - 1) where id = p_post_id;

  if p_parent_id is not null then
    update comments set reply_count = greatest(0, reply_count - 1) where id = p_parent_id;
  end if;
end;
$function$;

CREATE OR REPLACE FUNCTION public.delete_comment(p_comment_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_post_id uuid;
  v_parent_id uuid;
begin
  select post_id, parent_id into v_post_id, v_parent_id
  from comments where id = p_comment_id;

  delete from comment_likes where comment_id in (
    select id from comments where parent_id = p_comment_id
  );
  delete from comments where parent_id = p_comment_id;

  delete from comment_likes where comment_id = p_comment_id;
  delete from comments where id = p_comment_id;

  perform decrement_comment_count(v_post_id, v_parent_id);
end;
$function$;

CREATE OR REPLACE FUNCTION public.add_view(p_post_id uuid, p_user_id uuid DEFAULT NULL::uuid, p_session_id text DEFAULT NULL::text)
 RETURNS TABLE(counted boolean, views bigint)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_auth_user_id uuid;
  v_lock_key bigint;
  v_last_view timestamptz;
  v_counted boolean := false;
  v_views bigint := 0;
  v_session_id text;
BEGIN
  -- ==============================================================
  -- VALIDATE POST
  -- ==============================================================
  IF p_post_id IS NULL THEN
    RETURN QUERY SELECT false, 0::bigint;
    RETURN;
  END IF;

  -- ==============================================================
  -- HARDEN p_user_id: never trust a caller-supplied UUID as proof
  -- of identity. This function is SECURITY DEFINER, so an arbitrary
  -- p_user_id could otherwise be used to inflate/attribute views to
  -- any account. auth.uid() is the actual verified identity of the
  -- Supabase session making the call.
  -- ==============================================================
  v_auth_user_id := auth.uid();

  -- ==============================================================
  -- NO VIEWER IDENTITY AT ALL — nothing to dedupe against
  -- ==============================================================
  v_session_id := NULLIF(trim(COALESCE(p_session_id, '')), '');

  IF v_auth_user_id IS NULL AND v_session_id IS NULL THEN
    -- ─── FIX: qualify posts.views with alias "p" to avoid ambiguity
    -- with the RETURNS TABLE output column also named "views" ───────
    SELECT COALESCE(p.views, 0) INTO v_views FROM public.posts p WHERE p.id = p_post_id;
    RETURN QUERY SELECT false, v_views;
    RETURN;
  END IF;

  -- ==============================================================
  -- ADVISORY LOCK per (post, viewer)
  -- ==============================================================
  v_lock_key := hashtextextended(
    p_post_id::text || ':' || COALESCE(v_auth_user_id::text, v_session_id),
    0
  );
  PERFORM pg_advisory_xact_lock(v_lock_key);

  -- ==============================================================
  -- FIND THIS VIEWER'S LAST VIEW OF THIS POST
  -- ==============================================================
  IF v_auth_user_id IS NOT NULL THEN
    SELECT MAX(pv.viewed_at) INTO v_last_view
    FROM public.post_views pv
    WHERE pv.post_id = p_post_id AND pv.user_id = v_auth_user_id;
  ELSE
    SELECT MAX(pv.viewed_at) INTO v_last_view
    FROM public.post_views pv
    WHERE pv.post_id = p_post_id AND pv.session_id = v_session_id;
  END IF;

  -- ==============================================================
  -- EXACT ROLLING 24-HOUR WINDOW
  -- ==============================================================
  IF v_last_view IS NULL OR v_last_view <= now() - interval '24 hours' THEN
    INSERT INTO public.post_views (post_id, user_id, session_id, viewed_at)
    VALUES (
      p_post_id,
      v_auth_user_id,
      CASE WHEN v_auth_user_id IS NULL THEN v_session_id ELSE NULL END,
      now()
    );

    -- ─── FIX: qualify BOTH sides — target column via alias "p" so
    -- "views" inside COALESCE(views, 0) can't resolve to the
    -- RETURNS TABLE output variable "views" instead of the column ───
    UPDATE public.posts AS p
    SET views = COALESCE(p.views, 0) + 1
    WHERE p.id = p_post_id;

    v_counted := true;
  END IF;

  -- ==============================================================
  -- RETURN AUTHORITATIVE COUNT
  -- ─── FIX: qualified here too, for the same reason ─────────────
  -- ==============================================================
  SELECT COALESCE(p.views, 0) INTO v_views FROM public.posts p WHERE p.id = p_post_id;

  RETURN QUERY SELECT v_counted, v_views;
END;
$function$;

CREATE OR REPLACE FUNCTION public.update_group_info(p_conversation_id uuid, p_name text DEFAULT NULL::text, p_description text DEFAULT NULL::text, p_avatar text DEFAULT NULL::text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_role text;
  v_can_edit text;
begin
  select role into v_role from public.conversation_members
  where conversation_id = p_conversation_id and user_id = auth.uid();

  select permissions->>'edit_group_info' into v_can_edit
  from public.conversations where id = p_conversation_id;

  if v_role is null then
    raise exception 'Not a member of this group';
  end if;

  if v_can_edit = 'admins' and v_role not in ('owner', 'admin') then
    raise exception 'Only admins can edit group info';
  end if;

  update public.conversations
  set group_name = coalesce(p_name, group_name),
      group_description = coalesce(p_description, group_description),
      group_avatar = coalesce(p_avatar, group_avatar),
      updated_at = now()
  where id = p_conversation_id;
end;
$function$;

CREATE OR REPLACE FUNCTION public.set_member_role(p_conversation_id uuid, p_target_user_id uuid, p_new_role text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_caller_role text;
  v_target_role text;
begin
  select role into v_caller_role from public.conversation_members
  where conversation_id = p_conversation_id and user_id = auth.uid();

  select role into v_target_role from public.conversation_members
  where conversation_id = p_conversation_id and user_id = p_target_user_id;

  if v_caller_role != 'owner' then
    raise exception 'Only the group owner can assign or remove admins';
  end if;

  if v_target_role = 'owner' then
    raise exception 'Cannot change the owner''s role';
  end if;

  if p_new_role not in ('admin', 'member') then
    raise exception 'Invalid role';
  end if;

  update public.conversation_members
  set role = p_new_role
  where conversation_id = p_conversation_id and user_id = p_target_user_id;
end;
$function$;

CREATE OR REPLACE FUNCTION public.get_or_create_invite_code(p_conversation_id uuid)
 RETURNS text
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_role text;
  v_can_invite text;
  v_code text;
begin
  select role into v_role from public.conversation_members
  where conversation_id = p_conversation_id and user_id = auth.uid();

  if v_role is null then
    raise exception 'Not a member of this group';
  end if;

  select permissions->>'invite_via_link' into v_can_invite
  from public.conversations where id = p_conversation_id;

  if v_can_invite = 'admins' and v_role not in ('owner', 'admin') then
    raise exception 'Only admins can generate an invite link';
  end if;

  select invite_code into v_code from public.conversations where id = p_conversation_id;

  if v_code is null then
    v_code := substr(md5(random()::text || clock_timestamp()::text), 1, 10);
    update public.conversations set invite_code = v_code where id = p_conversation_id;
  end if;

  return v_code;
end;
$function$;

CREATE OR REPLACE FUNCTION public.join_group_via_code(p_invite_code text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_conv_id uuid;
  v_requires_approval boolean;
  v_already_member boolean;
begin
  select id, (permissions->>'approve_new_members')::boolean
    into v_conv_id, v_requires_approval
  from public.conversations
  where invite_code = p_invite_code and invite_enabled = true;

  if v_conv_id is null then
    raise exception 'Invalid or expired invite link';
  end if;

  select exists(
    select 1 from public.conversation_members
    where conversation_id = v_conv_id and user_id = auth.uid()
  ) into v_already_member;

  if v_already_member then
    return jsonb_build_object('status', 'already_member', 'conversation_id', v_conv_id);
  end if;

  if v_requires_approval then
    insert into public.group_join_requests (conversation_id, user_id)
    values (v_conv_id, auth.uid())
    on conflict (conversation_id, user_id) do update set status = 'pending', created_at = now();
    return jsonb_build_object('status', 'pending_approval', 'conversation_id', v_conv_id);
  else
    insert into public.conversation_members (conversation_id, user_id, role)
    values (v_conv_id, auth.uid(), 'member');
    return jsonb_build_object('status', 'joined', 'conversation_id', v_conv_id);
  end if;
end;
$function$;

CREATE OR REPLACE FUNCTION public.resolve_join_request(p_request_id uuid, p_approve boolean)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
  v_conv_id uuid;
  v_target_user uuid;
  v_caller_role text;
begin
  select conversation_id, user_id into v_conv_id, v_target_user
  from public.group_join_requests where id = p_request_id;

  select role into v_caller_role from public.conversation_members
  where conversation_id = v_conv_id and user_id = auth.uid();

  if v_caller_role not in ('owner', 'admin') then
    raise exception 'Only admins can approve join requests';
  end if;

  if p_approve then
    insert into public.conversation_members (conversation_id, user_id, role)
    values (v_conv_id, v_target_user, 'member')
    on conflict do nothing;
    update public.group_join_requests set status = 'approved' where id = p_request_id;
  else
    update public.group_join_requests set status = 'rejected' where id = p_request_id;
  end if;
end;
$function$;

CREATE OR REPLACE FUNCTION public.set_message_expiry()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
declare
  v_duration integer;
begin
  select disappearing_duration into v_duration
  from public.conversations where id = new.conversation_id;

  if v_duration is not null and v_duration > 0 then
    new.expires_at := now() + (v_duration || ' seconds')::interval;
  end if;

  return new;
end;
$function$;

CREATE OR REPLACE FUNCTION public.is_member_of_conversation(p_conversation_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM conversation_members
    WHERE conversation_id = p_conversation_id
      AND user_id = auth.uid()
  );
$function$;

CREATE OR REPLACE FUNCTION public.can_send_in_conversation(p_conversation_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT
    CASE
      WHEN NOT c.is_group THEN true
      WHEN c.is_note THEN true
      WHEN COALESCE(c.permissions->>'send_messages', 'everyone') = 'everyone' THEN true
      ELSE EXISTS (
        SELECT 1 FROM conversation_members cm
        WHERE cm.conversation_id = p_conversation_id
          AND cm.user_id = auth.uid()
          AND cm.role IN ('owner', 'admin')
      )
    END
  FROM conversations c
  WHERE c.id = p_conversation_id;
$function$;

CREATE OR REPLACE FUNCTION public.notify_new_message()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
begin
  perform net.http_post(
    url := 'https://__STAGING_PROJECT_REF__.functions.supabase.co/send-push-notification',
    headers := jsonb_build_object('Content-Type', 'application/json', 'x-freeupper-staging-secret', (SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name = 'freeupper_staging_webhook_secret')),
    body := jsonb_build_object('type', 'INSERT', 'table', 'messages', 'record', row_to_json(NEW))
  );
  return NEW;
end;
$function$;

CREATE OR REPLACE FUNCTION public.is_owner_or_admin_of_conversation(p_conversation_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM conversation_members
    WHERE conversation_id = p_conversation_id
      AND user_id = auth.uid()
      AND role IN ('owner','admin')
  );
$function$;

CREATE OR REPLACE FUNCTION public.conversation_has_any_members(p_conversation_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1
    FROM public.conversation_members
    WHERE conversation_id = p_conversation_id
  );
$function$;

CREATE OR REPLACE FUNCTION public.protect_profile_privileged_columns()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
  IF (
    NEW.verified        IS DISTINCT FROM OLD.verified OR
    NEW.verified_status IS DISTINCT FROM OLD.verified_status
  ) AND NOT is_admin_user(auth.uid()) THEN
    RAISE EXCEPTION 'Only admins can change verified or verified_status';
  END IF;
  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.notify_new_comment()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_post_owner UUID;
  v_parent_author UUID;
  v_parent_post_id UUID;
BEGIN
  IF NEW.parent_id IS NULL THEN
    -- Top-level comment on a post
    SELECT user_id INTO v_post_owner
    FROM posts
    WHERE id = NEW.post_id;

    IF v_post_owner IS NULL THEN
      RETURN NEW;
    END IF;

    IF v_post_owner = NEW.user_id THEN
      RETURN NEW;
    END IF;

    PERFORM create_notification(v_post_owner, NEW.user_id, 'comment', NEW.post_id, NEW.id);
  ELSE
    -- Reply to another comment
    SELECT user_id, post_id INTO v_parent_author, v_parent_post_id
    FROM comments
    WHERE id = NEW.parent_id;

    IF v_parent_author IS NULL THEN
      RETURN NEW;
    END IF;

    IF v_parent_author = NEW.user_id THEN
      RETURN NEW;
    END IF;

    PERFORM create_notification(
      v_parent_author,
      NEW.user_id,
      'reply',
      v_parent_post_id,
      NEW.id
    );
  END IF;

  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.create_mention_notification(p_receiver_id uuid, p_post_id uuid DEFAULT NULL::uuid, p_comment_id uuid DEFAULT NULL::uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
begin
    -- Require an authenticated caller.
    if auth.uid() is null then
        raise exception 'Authentication required';
    end if;

    -- Ignore invalid recipient.
    if p_receiver_id is null then
        return;
    end if;

    -- Never notify a user about their own mention.
    if p_receiver_id = auth.uid() then
        return;
    end if;

    -- A mention notification must point to actual mention data.
    if p_comment_id is not null then
        -- When both IDs are supplied, they must refer to the same post.
        if p_post_id is not null
           and not exists (
               select 1
               from public.comments c
               where c.id = p_comment_id
                 and c.post_id = p_post_id
           )
        then
            return;
        end if;

        -- The recipient must actually be mentioned in this comment.
        if not exists (
            select 1
            from public.comments c
            where c.id = p_comment_id
              and c.mentions @> jsonb_build_array(
                  jsonb_build_object('userId', p_receiver_id::text)
              )
        )
        then
            return;
        end if;

    elsif p_post_id is not null then
        -- The recipient must actually be mentioned in this post.
        if not exists (
            select 1
            from public.posts p
            where p.id = p_post_id
              and p.mentions @> jsonb_build_array(
                  jsonb_build_object('userId', p_receiver_id::text)
              )
        )
        then
            return;
        end if;
    else
        -- A mention notification must reference a post or comment.
        return;
    end if;

    -- Actor is always taken from the authenticated session.
    perform public.create_notification(
        p_receiver_id,
        auth.uid(),
        'mention',
        p_post_id,
        p_comment_id
    );
end;
$function$;

CREATE OR REPLACE FUNCTION public.get_unread_message_count()
 RETURNS bigint
 LANGUAGE sql
 STABLE
 SET search_path TO 'public'
AS $function$
  SELECT count(*)::bigint
  FROM public.messages AS m
  WHERE auth.uid() IS NOT NULL
    AND m.sender_id <> auth.uid()
    AND NOT EXISTS (
      SELECT 1
      FROM public.message_reads AS mr
      WHERE mr.message_id = m.id
        AND mr.user_id = auth.uid()
    )
    AND (
      EXISTS (
        SELECT 1
        FROM public.conversations AS c
        WHERE c.id = m.conversation_id
          AND (
            c.user1_id = auth.uid()
            OR c.user2_id = auth.uid()
          )
      )
      OR EXISTS (
        SELECT 1
        FROM public.conversation_members AS cm
        WHERE cm.conversation_id = m.conversation_id
          AND cm.user_id = auth.uid()
      )
    );
$function$;

CREATE OR REPLACE FUNCTION public.get_unread_message_count(p_user_id uuid)
 RETURNS bigint
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  with user_conversations as (
    select c.id
    from public.conversations c
    where coalesce(c.is_note, false) = false
      and (
        (
          coalesce(c.is_group, false) = false
          and (c.user1_id = p_user_id or c.user2_id = p_user_id)
        )
        or exists (
          select 1
          from public.conversation_members cm
          where cm.conversation_id = c.id
            and cm.user_id = p_user_id
        )
      )
  )
  select count(*)::bigint
  from public.messages m
  where m.conversation_id in (select id from user_conversations)
    and m.sender_id <> p_user_id
    and coalesce(m.is_system, false) = false
    and m.deleted_at is null
    and (m.expires_at is null or m.expires_at > now())
    and not exists (
      select 1
      from public.message_reads mr
      where mr.message_id = m.id
        and mr.user_id = p_user_id
    );
$function$;

CREATE OR REPLACE FUNCTION public.get_my_unread_message_count()
 RETURNS bigint
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  select public.get_unread_message_count((select auth.uid()));
$function$;

