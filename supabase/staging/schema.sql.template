CREATE OR REPLACE FUNCTION public.toggle_bookmark(p_post_id uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_user_id UUID := auth.uid();
  exists_bookmark BOOLEAN;
BEGIN
  IF v_user_id IS NULL THEN
    RAISE EXCEPTION 'Not authenticated';
  END IF;
  SELECT EXISTS(SELECT 1 FROM bookmarks WHERE post_id = p_post_id AND user_id = v_user_id)
  INTO exists_bookmark;
  IF exists_bookmark THEN
    DELETE FROM bookmarks WHERE post_id = p_post_id AND user_id = v_user_id;
  ELSE
    INSERT INTO bookmarks (post_id, user_id) VALUES (p_post_id, v_user_id);
  END IF;
  RETURN NOT exists_bookmark;
END;
$function$;

CREATE OR REPLACE FUNCTION public.edit_comment(p_comment_id uuid, p_message text)
 RETURNS comments
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  updated_comment comments;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM comments WHERE id = p_comment_id AND user_id = auth.uid() AND is_deleted = false) THEN
    RAISE EXCEPTION 'Comment not found or not owned';
  END IF;
  IF p_message IS NULL OR trim(p_message) = '' THEN
    RAISE EXCEPTION 'Message cannot be empty';
  END IF;
  UPDATE comments
  SET
    message = p_message,
    edited_at = now(),
    version = version + 1
  WHERE id = p_comment_id
  RETURNING * INTO updated_comment;
  RETURN updated_comment;
END;
$function$;

