CREATE OR REPLACE FUNCTION public.protect_profile_identity_fields()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
    IF TG_OP = 'INSERT' THEN
        IF COALESCE(auth.role(), '') <> 'service_role' THEN
            NEW.is_admin := false;
            NEW.verified := false;
            NEW.verified_status := 'none';
            NEW.verification_status := 'none';
            NEW.verification_category := NULL;
            NEW.verification_reason := NULL;
            NEW.verification_link := NULL;
            NEW.verification_submitted_at := NULL;
            NEW.suspended := false;
            NEW.suspended_reason := NULL;
            NEW.suspended_at := NULL;
        END IF;
        RETURN NEW;
    END IF;

    IF TG_OP = 'UPDATE' THEN
        IF NEW.freeupper_id IS DISTINCT FROM OLD.freeupper_id THEN
            RAISE EXCEPTION 'freeupper_id is immutable and cannot be changed';
        END IF;

        IF (
            NEW.is_admin IS DISTINCT FROM OLD.is_admin
            OR NEW.verified IS DISTINCT FROM OLD.verified
            OR NEW.verified_status IS DISTINCT FROM OLD.verified_status
            OR NEW.verification_status IS DISTINCT FROM OLD.verification_status
            OR NEW.verification_category IS DISTINCT FROM OLD.verification_category
            OR NEW.verification_reason IS DISTINCT FROM OLD.verification_reason
            OR NEW.verification_link IS DISTINCT FROM OLD.verification_link
            OR NEW.verification_submitted_at IS DISTINCT FROM OLD.verification_submitted_at
            OR NEW.suspended IS DISTINCT FROM OLD.suspended
            OR NEW.suspended_reason IS DISTINCT FROM OLD.suspended_reason
            OR NEW.suspended_at IS DISTINCT FROM OLD.suspended_at
        )
        AND COALESCE(auth.role(), '') <> 'service_role'
        AND NOT public.is_admin_user(auth.uid())
        THEN
            RAISE EXCEPTION 'Only administrators can modify privileged profile fields';
        END IF;

        RETURN NEW;
    END IF;

    RAISE EXCEPTION 'Unexpected trigger operation: %', TG_OP;
END;
$function$;

CREATE OR REPLACE FUNCTION public.block_user(p_blocked_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_blocker_id uuid := auth.uid();
BEGIN

    IF v_blocker_id IS NULL THEN
        RAISE EXCEPTION 'Authentication required';
    END IF;

    IF p_blocked_id IS NULL THEN
        RAISE EXCEPTION 'Blocked user is required';
    END IF;

    IF p_blocked_id = v_blocker_id THEN
        RAISE EXCEPTION 'You cannot block yourself';
    END IF;

    INSERT INTO public.blocks (blocker_id, blocked_id)
    VALUES (v_blocker_id, p_blocked_id)
    ON CONFLICT DO NOTHING;

    DELETE FROM public.follows
    WHERE
        (follower_id = v_blocker_id AND following_id = p_blocked_id)
        OR
        (follower_id = p_blocked_id AND following_id = v_blocker_id);

    DELETE FROM public.dismissed_suggestions
    WHERE
        user_id = v_blocker_id
        AND dismissed_user_id = p_blocked_id;

END;
$function$;

CREATE OR REPLACE FUNCTION public.get_profile_by_freeupper_id(p_freeupper_id text)
 RETURNS TABLE(profile_id uuid, freeupper_id text, username text, display_name text, display_username text, avatar_url text, cover_url text, bio text, verified boolean, verified_status text, verification_status text, is_private boolean, hide_follower_count boolean, activity_status boolean, country text, created_at timestamp with time zone)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
