{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freeupper-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "keep_vars": true,
  "routes": [{ "pattern": "api.freeupper.com", "custom_domain": true }],
  "observability": { "enabled": false }
}
