{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freeupper-web",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "previews": {},
  "assets": {
    "directory": "./cloudflare/generated/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/v/*", "/p/*", "/u/*", "/@*", "/sitemap-profiles.xml", "/__migration/health"]
  },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ]
}
