{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freeupper-web",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    { "pattern": "freeupper.com", "custom_domain": true },
    { "pattern": "www.freeupper.com", "custom_domain": true }
  ],
  "previews": {},
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./cloudflare/generated/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/home", "/search", "/create", "/videos", "/profile", "/messages", "/settings", "/notifications", "/api/*", "/v/*", "/p/*", "/u/*", "/@*", "/sitemap-profiles.xml", "/sitemap-posts.xml", "/__migration/health"]
  },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ]
}
