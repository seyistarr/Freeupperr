{
  "name": "freeupper-web-staging",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v/*", "/p/*", "/u/*", "/@*", "/sitemap-profiles.xml"]
  }
}
